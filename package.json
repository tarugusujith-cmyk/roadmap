{
  "name": "productpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ProductPulse - customer feedback & product roadmap SaaS (React + TypeScript + Vite + Tailwind + JSON Server)",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:api\" \"npm:web\"",
    "api": "node server.js",
    "web": "vite",
    "start": "node server.js",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "json-server": "0.17.4",
    "lucide-react": "~0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
